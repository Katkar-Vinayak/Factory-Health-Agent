# Factory Health & Response Agent - Backend Configuration Example
# Copy to .env for local overrides (never commit .env)

# JWT & Authentication Configuration
JWT_SECRET_KEY=factory_health_agent_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Demo Operator Provisioning Seed
DEMO_OPERATOR_PASSWORD=Factory@123!

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
